source /etc/profile

export PATH=~/.composer/vendor/bin/:$PATH

echo "[client]" >~/.my.cnf
echo "host=db" >>~/.my.cnf
[ -n "$MYSQL_ROOT_PASSWORD" ] && echo "user=root" >>~/.my.cnf
[ -n "$MYSQL_ROOT_PASSWORD" ] && echo "password=${MYSQL_ROOT_PASSWORD}" >>~/.my.cnf

echo "" >>~/.my.cnf
echo "[mysql]" >>~/.my.cnf
echo "skip-ssl" >>~/.my.cnf
[ -n "$MYSQL_DATABASE" ] && echo "database=${MYSQL_DATABASE}" >>~/.my.cnf
