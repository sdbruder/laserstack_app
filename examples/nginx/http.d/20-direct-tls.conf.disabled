# nginx terminates TLS here. Disabled by default: the include pattern is
# http.d/*.conf. Mount the certificates, then rename this file to
# 20-direct-tls.conf.
#
# Certificates: /etc/nginx/certs/fullchain.pem and /etc/nginx/certs/privkey.pem
# Renew them outside the container and reload nginx:
# `supervisorctl signal HUP nginx`.

server {
	listen       8443 ssl;
	listen       [::]:8443 ssl;
	http2        on;
	server_name  app-tls.example.com;

	ssl_certificate      /etc/nginx/certs/fullchain.pem;
	ssl_certificate_key  /etc/nginx/certs/privkey.pem;

	# nginx has no line continuation: the value stays on one line.
	add_header  Strict-Transport-Security  "max-age=31536000; includeSubDomains"  always;

	set  $app_https  $https;

	include  /etc/nginx/snippets/server-body.conf;
}

# Plain HTTP on the same name: serve the certificate challenge, redirect
# everything else. The redirect targets the default HTTPS port; change it when
# you publish the TLS port as something other than 443.
server {
	listen       8080;
	server_name  app-tls.example.com;

	location ^~ /.well-known/acme-challenge/ {
		root  /var/www/acme;
	}

	location / {
		return  301  https://$host$request_uri;
	}
}
