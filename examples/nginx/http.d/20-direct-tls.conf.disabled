# nginx terminates TLS here. Disabled by default: the include pattern is
# http.d/*.conf. Mount the certificates, then rename this file to
# 20-direct-tls.conf.
#
# Certificates: /etc/nginx/certs/fullchain.pem and /etc/nginx/certs/privkey.pem
# Renew them outside the container and reload nginx: `supervisorctl signal HUP nginx`.

server {
	listen       443 ssl;
	listen       [::]:443 ssl;
	http2        on;
	server_name  app-tls.example.com;

	ssl_certificate      /etc/nginx/certs/fullchain.pem;
	ssl_certificate_key  /etc/nginx/certs/privkey.pem;

	root   /var/www/app/public;
	index  index.php index.html;
	charset  utf-8;

	# nginx has no line continuation: the value stays on one line.
	add_header  Strict-Transport-Security  "max-age=31536000; includeSubDomains"  always;

	set  $app_https  $https;

	include  /etc/nginx/snippets/security-headers.conf;

	location ~ /\.(?!well-known/) {
		deny  all;
		access_log  off;
		log_not_found  off;
	}

	include  /etc/nginx/snippets/static-assets.conf;

	location / {
		try_files  $uri  /index.php?$query_string;
	}

	include  /etc/nginx/snippets/php-fpm.conf;

	location = /favicon.ico { access_log off; log_not_found off; }
	location = /robots.txt  { access_log off; log_not_found off; }
}

# Plain HTTP on the same name: serve the certificate challenge, redirect
# everything else.
server {
	listen       80;
	server_name  app-tls.example.com;

	location ^~ /.well-known/acme-challenge/ {
		root  /var/www/acme;
	}

	location / {
		return  301  https://$host$request_uri;
	}
}
